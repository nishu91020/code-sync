# Port serving both the HTTP API and the WebSocket endpoint.
PORT=3001

# Comma-separated list of allowed browser origins. Use "*" to allow any origin.
CORS_ORIGIN=http://localhost:3000

# Postgres connection string. When unset, rooms are kept in memory only and are
# lost when the process exits.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb?schema=public

# How long to wait after an edit before writing a snapshot, in milliseconds.
SAVE_DEBOUNCE_MS=5000

# Code runs in per-language Docker images built with `npm run runners:build`.
# The backend talks to the local Docker engine (named pipe on Windows, socket
# elsewhere). Set DOCKER_HOST to use a different engine. RUNNER_DRIVER=none
# disables execution entirely.
# DOCKER_HOST=
# RUNNER_DRIVER=docker

# Stop a language's warm container this long after no open room uses it.
RUNNER_IDLE_MS=300000
# Upper bound on runner containers alive at once, warm or running.
RUNNER_MAX_CONTAINERS=6
# CPUs each runner container may use.
RUNNER_CPUS=2
# Optional sandboxed OCI runtime for stronger isolation, e.g. gVisor's runsc.
# RUNNER_RUNTIME=runsc

# Execution limits. RUN_TIMEOUT_MS is wall-clock time, compilation included.
RUN_TIMEOUT_MS=15000
RUN_RATE_LIMIT=10
RUN_RATE_WINDOW_MS=60000

# Join requests allowed per client IP per minute (protects hosts from spam).
JOIN_RATE_LIMIT=10
